#!/usr/bin/env ruby
# SPDX-FileCopyrightText: 2026 SergioZ3R0
# SPDX-License-Identifier: Apache-2.0
# frozen_string_literal: true

# Locate the library both when running from a checkout and when installed.
[
  ENV["ONE_NHC_LIB"],
  File.expand_path("../lib", __dir__),
  "/usr/local/lib/one-nhc/lib",
  "/usr/lib/one-nhc/lib"
].compact.each do |candidate|
  $LOAD_PATH.unshift(candidate) if File.file?(File.join(candidate, "one_nhc.rb"))
end

require "one_nhc"
require "json"
require "optparse"

DEFAULT_CONFIG = "/etc/one-nhc/one-nhc.conf"
DEFAULT_STATE  = "/var/lib/one-nhc/state.json"

def usage
  <<~USAGE
    one-nhc #{OneNHC::VERSION} - NHC-style health checks for OpenNebula

    Usage:
      one-nhc check       [options]   run checks and print a human report
      one-nhc probe       [options]   run checks and print OpenNebula IM attributes
      one-nhc controller  [options]   evaluate hosts and apply the configured mode
      one-nhc list                    list available checks
      one-nhc version                 print version

    Options:
      -c, --config FILE    config file (default: #{DEFAULT_CONFIG})
      -n, --node NAME      evaluate targeting as if running on NAME
      -j, --json           JSON output (check and controller)
      -o, --only IDS       comma separated check ids to run
          --once           run the controller once (default)
          --watch          run the controller in a loop
          --interval SECS  seconds between controller runs (default: config)
          --mode MODE      controller mode: monitor, notify or act
          --dry-run        log controller decisions without changing hosts
          --state FILE     controller state file (default: #{DEFAULT_STATE})
      -q, --quiet          suppress the controller's "no action needed" message
      -h, --help           show this help
  USAGE
end

options = {
  config: DEFAULT_CONFIG,
  json: false,
  only: nil,
  node: nil,
  once: false,
  watch: false,
  interval: nil,
  mode: nil,
  dry_run: nil,
  state: nil,
  quiet: false
}

parser = OptionParser.new do |opts|
  opts.on("-c", "--config FILE") { |value| options[:config] = value }
  opts.on("-n", "--node NAME") { |value| options[:node] = value }
  opts.on("-j", "--json") { options[:json] = true }
  opts.on("-o", "--only IDS") { |value| options[:only] = value.split(",").map(&:strip) }
  opts.on("--once") { options[:once] = true }
  opts.on("--watch") { options[:watch] = true }
  opts.on("--interval SECONDS", Integer) { |value| options[:interval] = value }
  opts.on("--mode MODE") { |value| options[:mode] = value }
  opts.on("--dry-run") { options[:dry_run] = true }
  opts.on("--state FILE") { |value| options[:state] = value }
  opts.on("-q", "--quiet") { options[:quiet] = true }
  opts.on("-h", "--help") { puts usage; exit 0 }
end
parser.parse!(ARGV)

command = ARGV.shift
OneNHC.load_checks

def build_runner(options)
  config = OneNHC::Config.load(options[:config])
  config.validate!

  node = options[:node] || config["node_name"] || OneNHC.node_name
  [config, OneNHC::Runner.new(config, only: options[:only], node: node)]
end

def controller_state_file(config, options)
  state_file = options[:state] || config.dig("controller", "state_file") || DEFAULT_STATE
  state_file.to_s.strip.empty? ? DEFAULT_STATE : state_file
end

def build_controller(config, options, state_file)
  raise ArgumentError, "--once and --watch are mutually exclusive" if options[:once] && options[:watch]

  mode = options[:mode]
  if mode && !OneNHC::Controller::MODES.include?(mode)
    raise ArgumentError,
          "invalid controller mode '#{mode}' (use #{OneNHC::Controller::MODES.join(', ')})"
  end

  require "one_nhc/on_api"

  OneNHC::Controller.new(
    config,
    api: OneNHC::OnAPI.new,
    state: OneNHC::State.new(state_file),
    notifier: OneNHC::Notifier.new(config),
    mode: mode,
    dry_run: options[:dry_run],
    logger: options[:json] ? ->(_message) {} : nil
  )
end

def controller_payload(decisions)
  decisions.map do |decision|
    {
      "host" => decision.host.name,
      "host_id" => decision.host.id,
      "status" => decision.host.status,
      "action" => decision.action.to_s,
      "applied" => decision.applied,
      "reason" => decision.reason
    }
  end
end

def run_controller_once(controller, json, quiet: false)
  decisions = controller.run

  if json
    puts JSON.generate(controller_payload(decisions))
  elsif decisions.empty? && !quiet
    puts "[one-nhc] no action needed"
  end
end

def run_controller_watch(controller, interval, json)
  stop = false
  %w[INT TERM].each { |signal| trap(signal) { stop = true } }

  until stop
    run_controller_once(controller, json, quiet: true)
    sleep interval
  end
end

begin
  case command
  when "check"
    _config, runner = build_runner(options)
    results = runner.results

    output = if options[:json]
               OneNHC::Adapters::Json.render(results)
             else
               OneNHC::Adapters::Human.render(results)
             end
    print output

    unless options[:json]
      skipped = runner.not_targeted
      puts "not targeted on #{runner.node}: #{skipped.map(&:id).join(', ')}" unless skipped.empty?
    end

    exit OneNHC::Runner.exit_code(results)
  when "probe"
    _config, runner = build_runner(options)
    print OneNHC::Adapters::OnMonitor.render(runner.probe_results)
  when "controller"
    config     = OneNHC::Config.load(options[:config])
    config.validate!
    state_file = controller_state_file(config, options)
    controller = build_controller(config, options, state_file)

    interval = options[:interval] || config.dig("controller", "interval") || 60
    interval = Integer(interval)
    raise ArgumentError, "controller interval must be >= 1" if interval < 1

    lock = OneNHC::Lock.new("#{state_file}.lock")
    unless lock.acquire
      if options[:json]
        puts "[]"
      else
        puts "[one-nhc] another controller is already running; skipping this cycle"
      end
      exit 0
    end

    begin
      if options[:watch]
        run_controller_watch(controller, interval, options[:json])
      else
        run_controller_once(controller, options[:json], quiet: options[:quiet])
      end
    ensure
      lock.release
    end
  when "list"
    OneNHC.checks.each { |check| puts format("%-24s %s", check.id, check.description) }
  when "version", "-V", "--version"
    puts OneNHC::VERSION
  when nil
    puts usage
    exit 1
  else
    warn "one-nhc: unknown command '#{command}'"
    puts usage
    exit 1
  end
rescue ArgumentError => e
  if command == "probe"
    puts OneNHC::Adapters::OnMonitor.kv("NHC_STATUS", "UNKNOWN")
    puts OneNHC::Adapters::OnMonitor.kv("NHC_ERROR", e.message)
  else
    warn "one-nhc: #{e.message}"
  end
  exit 1
rescue LoadError => e
  warn "one-nhc: the controller needs the OpenNebula Ruby bindings: #{e.message}"
  exit 1
rescue StandardError => e
  raise unless command == "controller"

  warn "one-nhc: controller failed: #{e.class}: #{e.message}"
  exit 1
end
