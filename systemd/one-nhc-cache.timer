[Unit]
Description=Run the one-nhc heavy check cache periodically
Documentation=https://github.com/SergioZ3R0/opennebula-nhc

[Timer]
OnBootSec=5min
OnUnitActiveSec=15min
AccuracySec=1min
RandomizedDelaySec=30s
Unit=one-nhc-cache.service

[Install]
WantedBy=timers.target
