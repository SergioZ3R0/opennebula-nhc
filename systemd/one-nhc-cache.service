[Unit]
Description=one-nhc heavy check cache
Documentation=https://github.com/SergioZ3R0/opennebula-nhc
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=oneadmin
Group=oneadmin
StateDirectory=one-nhc
StateDirectoryMode=0750
ExecStart=/usr/local/bin/one-nhc cache --quiet
Nice=10
# The command writes the cache even when a check is CRIT or UNKNOWN; its exit
# code is the worst status. Do not mark the unit failed for that.
SuccessExitStatus=0 1 2 3
